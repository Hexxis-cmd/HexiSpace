VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_HEXIGRID_ORIGIN=http://127.0.0.1:4318
VITE_MEDIA_PROVIDER=supabase
# Public OAuth client IDs for optional Gmail/Outlook mailbox connections.
# These are identifiers, not client secrets. Never put a client secret in Vite env values.
VITE_GOOGLE_MAIL_CLIENT_ID=
VITE_MICROSOFT_MAIL_CLIENT_ID=
